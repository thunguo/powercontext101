    "global": {
      "anchors": [
        {
          "anchor": "Official Docs",
          "href": "https://oceanbase.github.io/powercontext/",
          "icon": "book-open"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/oceanbase/powercontext",
          "icon": "code"
        }
      ]
    },
    "languages": [
