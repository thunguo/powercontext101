{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "PowerContext 101",
  "description": "PowerContext 使用与开发实战：心智模型、常用 API、框架集成、通用 Agent 与编程 Agent。",
  "search": {
    "prompt": "搜索"
  },
  "colors": {
    "primary": "#0b6ff4",
    "light": "#68adff",
    "dark": "#064faa"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "fonts": {
    "family": "Noto Sans",
    "heading": {
      "family": "IBM Plex Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#f7f9fc",
      "dark": "#071024"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "开始学习",
      "href": "/zh/start/learning-path"
    }
  },
